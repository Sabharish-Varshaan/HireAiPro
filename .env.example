# Copy to backend/.env. Placeholders only — never commit real keys.
DATABASE_URL=postgresql+asyncpg://hireai:hireai@localhost:5435/hireai
VALKEY_URL=redis://localhost:6380/0
QDRANT_URL=http://localhost:6333
UPLOAD_DIR=data/uploads
JWT_SECRET=  # REQUIRED: >=32 random chars, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"

# ---- LLM routing (docs/AI_ROUTING_AND_COST.md) ----
LLM_PROVIDER=router
LOCAL_ONLY=false            # true = Mode C offline: Ollama only, no cloud keys needed
LLM_PRIMARY_PROVIDER=groq
LLM_CHEAP_PROVIDER=openai
LLM_LOCAL_FALLBACK_PROVIDER=ollama

GROQ_API_KEY=               # optional (free tier); empty = skip Groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=             # optional; empty = never spend money
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHEAP_MODEL=gpt-6-luna
OPENAI_ESCALATION_MODEL=gpt-6-sol

OLLAMA_BASE_URL=http://localhost:11434   # native Ollama (GPU); model loads only on fallback
OLLAMA_MODEL=qwen3.5:4b

OPENAI_DAILY_SOFT_LIMIT_USD=0.25
OPENAI_DAILY_HARD_LIMIT_USD=0.35
OPENAI_STARTING_BUDGET_USD=6.50
OPENAI_RESERVE_USD=3.00
LLM_MAX_RETRIES=1
LLM_MAX_AGENT_TURNS=6
LLM_TIMEOUT_SECONDS=60

# ---- Local models (lazy-loaded) ----
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_FP16=true         # halves unified memory on Apple Silicon / CUDA
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

JUDGE0_URL=http://localhost:2358
PYDANTIC_AI_NO_BANNER=1
